# -*- coding: utf-8 -*-
"""
CCPLI V4 Official Windows Application
=====================================
Comprehensive Composite Power Language Index (CCPLI V4)

Features
--------
- 10 official dimensions and 50 sub-indicators
- AHP dimension weights
- Equal allocation within each dimension: w_ij = W_i / 5
- Min-Max normalization to [0, 100]
- Linear weighted aggregation (base model)
- Zero-safe geometric aggregation (robustness model)
- Calibrated Dirichlet Monte Carlo (default 10,000 runs)
- +20% weight perturbation with renormalization
- LODO: Leave-One-Dimension-Out
- Spearman rho, Kendall tau, MARC, MaxRC
- Optional AHP consistency check from a 10x10 pairwise matrix
- Optional CVI from expert ratings for 50 indicators
- Excel report export
- Simple Tkinter Windows GUI

Input CSV format
----------------
First column: Language
Next 50 columns: the exact indicator names generated by this program.

Use "Create Template" in the GUI to create the correct CSV template.

Important methodological note
-----------------------------
The program does NOT invent research data. "Demo Data" is available only
as an explicit test function and is clearly labelled as simulated data.
"""

from __future__ import annotations

import os
import sys
import traceback
import warnings
from pathlib import Path
from typing import Dict, Optional, Tuple

import numpy as np
import pandas as pd
from scipy.stats import spearmanr, kendalltau

warnings.filterwarnings("ignore")

# Tkinter is part of standard Windows Python installations.
import tkinter as tk
from tkinter import filedialog, messagebox, ttk


APP_TITLE = "CCPLI V4 Official Engine"
DEFAULT_SIMULATIONS = 10_000
DEFAULT_PRECISION_K = 100
DEFAULT_PERTURBATION = 1.20


class CCPLIV4OfficialEngine:
    """Official CCPLI V4 calculation engine."""

    def __init__(self, raw_ahp_weights: Optional[Dict[str, float]] = None):
        if raw_ahp_weights is None:
            raw_ahp_weights = {
                "D1_Digital_Algorithmic": 0.12,
                "D2_TAFL_Education": 0.10,
                "D3_Linguistic_Structure": 0.10,
                "D4_Religious_Sacred": 0.10,
                "D5_Civilizational_Historical": 0.08,
                "D6_Knowledge_Scientific_Publishing": 0.10,
                "D7_Economic_Trade_Exposure": 0.12,
                "D8_Demographic_Spread": 0.10,
                "D9_Media_Public_Digital_Presence": 0.08,
                "D10_Geopolitical_Language_Policies": 0.10,
            }

        if len(raw_ahp_weights) != 10:
            raise ValueError("CCPLI V4 requires exactly 10 dimension weights.")

        total_w = float(sum(raw_ahp_weights.values()))
        if total_w <= 0:
            raise ValueError("The total dimension weight must be > 0.")

        self.dimension_weights = {
            k: float(v) / total_w for k, v in raw_ahp_weights.items()
        }

        self.indicators = []
        self.indicator_weights = {}

        for dim_code, dim_w in self.dimension_weights.items():
            sub_w = dim_w / 5.0
            for i in range(1, 6):
                ind_code = f"{dim_code}_I{i}"
                self.indicators.append(ind_code)
                self.indicator_weights[ind_code] = sub_w

    # ------------------------------------------------------------------
    # Validation
    # ------------------------------------------------------------------
    def validate_input(self, df: pd.DataFrame) -> None:
        if df.empty:
            raise ValueError("The input dataset is empty.")

        missing = [c for c in self.indicators if c not in df.columns]
        if missing:
            preview = ", ".join(missing[:8])
            more = " ..." if len(missing) > 8 else ""
            raise ValueError(
                f"Missing {len(missing)} required indicators: {preview}{more}"
            )

        if df.index.astype(str).duplicated().any():
            raise ValueError("Language names must be unique.")

        numeric = df[self.indicators].apply(pd.to_numeric, errors="coerce")
        if numeric.isna().all(axis=None):
            raise ValueError("No numeric indicator data were found.")

        if numeric.isna().any(axis=1).any():
            raise ValueError(
                "Missing/non-numeric values detected. "
                "Please complete the 50 indicators for every language."
            )

    # ------------------------------------------------------------------
    # AHP consistency
    # ------------------------------------------------------------------
    def calculate_ahp_consistency(self, pairwise_matrix) -> Dict[str, float]:
        matrix = np.asarray(pairwise_matrix, dtype=float)

        if matrix.shape != (10, 10):
            raise ValueError("AHP pairwise matrix must be exactly 10 x 10.")

        if not np.all(np.isfinite(matrix)):
            raise ValueError("AHP matrix contains non-finite values.")

        if np.any(matrix <= 0):
            raise ValueError("AHP pairwise values must be positive.")

        ri_dict = {
            1: 0.00, 2: 0.00, 3: 0.58, 4: 0.90, 5: 1.12,
            6: 1.24, 7: 1.32, 8: 1.41, 9: 1.45, 10: 1.49
        }

        eigenvalues = np.linalg.eigvals(matrix)
        lambda_max = float(np.max(np.real(eigenvalues)))
        n = 10
        ci = (lambda_max - n) / (n - 1)
        ri = ri_dict[n]
        cr = ci / ri if ri > 0 else 0.0

        return {
            "Lambda_Max": lambda_max,
            "CI": float(ci),
            "CR": float(cr),
            "Guideline_Pass_CR_<=_0.10": bool(cr <= 0.10),
        }

    # ------------------------------------------------------------------
    # Normalization
    # ------------------------------------------------------------------
    def normalize_min_max(
        self,
        df: pd.DataFrame,
        directions: Optional[Dict[str, int]] = None,
    ) -> pd.DataFrame:
        directions = directions or {}
        df_num = df[self.indicators].apply(pd.to_numeric, errors="raise")
        df_norm = pd.DataFrame(index=df_num.index)

        for col in self.indicators:
            min_val = float(df_num[col].min())
            max_val = float(df_num[col].max())
            direction = int(directions.get(col, 1))

            if direction not in (1, -1):
                raise ValueError(f"Direction for {col} must be 1 or -1.")

            if max_val == min_val:
                df_norm[col] = 50.0
            elif direction == 1:
                df_norm[col] = (
                    (df_num[col] - min_val) / (max_val - min_val) * 100.0
                )
            else:
                df_norm[col] = (
                    (max_val - df_num[col]) / (max_val - min_val) * 100.0
                )

        return df_norm

    # ------------------------------------------------------------------
    # Aggregation
    # ------------------------------------------------------------------
    def aggregate_linear(
        self,
        df_norm: pd.DataFrame,
        weights: Optional[Dict[str, float]] = None,
    ) -> pd.Series:
        w = weights if weights is not None else self.indicator_weights
        ws = pd.Series(w, dtype=float)
        ws = ws.reindex(self.indicators)

        if ws.isna().any():
            raise ValueError("Aggregation weights do not cover all 50 indicators.")

        return df_norm[self.indicators].dot(ws)

    def aggregate_geometric_zero_safe(
        self,
        df_norm: pd.DataFrame,
        weights: Optional[Dict[str, float]] = None,
    ) -> pd.Series:
        w = weights if weights is not None else self.indicator_weights
        ws = pd.Series(w, dtype=float).reindex(self.indicators)

        if ws.isna().any():
            raise ValueError("Geometric weights do not cover all 50 indicators.")

        # LPI_G = exp(sum(w_j * ln(1 + I_j))) - 1
        weighted_log = np.log1p(df_norm[self.indicators]).dot(ws)
        return np.expm1(weighted_log)

    # ------------------------------------------------------------------
    # Rank diagnostics
    # ------------------------------------------------------------------
    @staticmethod
    def rank_diagnostics(base_ranks: pd.Series, new_ranks: pd.Series):
        rho = spearmanr(base_ranks, new_ranks).statistic
        tau = kendalltau(base_ranks, new_ranks).statistic

        if pd.isna(rho):
            rho = 1.0
        if pd.isna(tau):
            tau = 1.0

        diff = (base_ranks - new_ranks).abs()
        return {
            "Spearman_Rho": float(rho),
            "Kendall_Tau": float(tau),
            "MARC": float(diff.mean()),
            "MaxRC": float(diff.max()),
        }

    # ------------------------------------------------------------------
    # Dirichlet Monte Carlo
    # ------------------------------------------------------------------
    def run_calibrated_dirichlet_monte_carlo(
        self,
        df_norm: pd.DataFrame,
        num_simulations: int = DEFAULT_SIMULATIONS,
        precision_k: float = DEFAULT_PRECISION_K,
        seed: int = 42,
    ) -> Tuple[Dict, pd.DataFrame]:
        if num_simulations < 100:
            raise ValueError("Monte Carlo simulations should be at least 100.")

        if precision_k <= 0:
            raise ValueError("precision_k must be > 0.")

        base_scores = self.aggregate_linear(df_norm)
        base_ranks = base_scores.rank(ascending=False, method="average")

        dim_names = list(self.dimension_weights.keys())
        base_dim_w = np.array(
            [self.dimension_weights[d] for d in dim_names], dtype=float
        )
        alpha_params = base_dim_w * float(precision_k)

        rng = np.random.default_rng(seed)

        score_records = []
        rank_records = []
        spearmans = np.empty(num_simulations)
        kendalls = np.empty(num_simulations)

        for sim in range(num_simulations):
            sampled_dim_w = rng.dirichlet(alpha_params)

            sampled_ind_w = {}
            for idx, dim_code in enumerate(dim_names):
                sub_w = sampled_dim_w[idx] / 5.0
                for i in range(1, 6):
                    sampled_ind_w[f"{dim_code}_I{i}"] = sub_w

            scores = self.aggregate_linear(df_norm, weights=sampled_ind_w)
            ranks = scores.rank(ascending=False, method="average")

            score_records.append(scores)
            rank_records.append(ranks)

            spearmans[sim] = spearmanr(base_ranks, ranks).statistic
            kendalls[sim] = kendalltau(base_ranks, ranks).statistic

        scores_df = pd.DataFrame(score_records)
        ranks_df = pd.DataFrame(rank_records)

        score_ci_low = scores_df.quantile(0.025, axis=0)
        score_ci_up = scores_df.quantile(0.975, axis=0)

        marc = (ranks_df.subtract(base_ranks, axis=1)).abs().mean(axis=0)
        max_rc = (ranks_df.subtract(base_ranks, axis=1)).abs().max(axis=0)

        mc_table = pd.DataFrame({
            "Base_Rank": base_ranks,
            "Score_95%_CI_Lower": score_ci_low,
            "Score_95%_CI_Upper": score_ci_up,
            "MARC": marc,
            "MaxRC": max_rc,
        })

        summary = {
            "Base_Ranks": base_ranks,
            "Score_95_CI_Lower": score_ci_low,
            "Score_95_CI_Upper": score_ci_up,
            "MARC_per_Language": marc,
            "MaxRC_per_Language": max_rc,
            "Avg_Spearman_Rho": float(np.nanmean(spearmans)),
            "Avg_Kendall_Tau": float(np.nanmean(kendalls)),
        }

        return summary, mc_table

    # ------------------------------------------------------------------
    # Weight perturbation
    # ------------------------------------------------------------------
    def weight_perturbation_scenario(
        self,
        df_norm: pd.DataFrame,
        factor: float = DEFAULT_PERTURBATION,
    ) -> pd.DataFrame:
        if factor <= 0:
            raise ValueError("Perturbation factor must be > 0.")

        base_ranks = self.aggregate_linear(df_norm).rank(
            ascending=False, method="average"
        )
        results = {}

        for dim_code in self.dimension_weights:
            p_dims = self.dimension_weights.copy()
            p_dims[dim_code] *= factor

            total = sum(p_dims.values())
            norm_dims = {k: v / total for k, v in p_dims.items()}

            new_ind_w = {
                f"{d}_I{i}": norm_dims[d] / 5.0
                for d in norm_dims
                for i in range(1, 6)
            }

            new_scores = self.aggregate_linear(df_norm, weights=new_ind_w)
            new_ranks = new_scores.rank(ascending=False, method="average")

            results[dim_code] = self.rank_diagnostics(
                base_ranks, new_ranks
            )

        return pd.DataFrame(results).T

    # ------------------------------------------------------------------
    # LODO
    # ------------------------------------------------------------------
    def leave_one_dimension_out_analysis(
        self,
        df_norm: pd.DataFrame,
    ) -> pd.DataFrame:
        base_ranks = self.aggregate_linear(df_norm).rank(
            ascending=False, method="average"
        )
        results = {}

        for dim_code in self.dimension_weights:
            rem_inds = [
                ind for ind in self.indicators
                if not ind.startswith(dim_code)
            ]

            raw_w = np.array(
                [self.indicator_weights[ind] for ind in rem_inds],
                dtype=float,
            )
            new_w = raw_w / raw_w.sum()

            scores_lodo = df_norm[rem_inds].dot(
                pd.Series(dict(zip(rem_inds, new_w)))
            )
            ranks_lodo = scores_lodo.rank(
                ascending=False, method="average"
            )

            results[dim_code] = self.rank_diagnostics(
                base_ranks, ranks_lodo
            )

        return pd.DataFrame(results).T

    # ------------------------------------------------------------------
    # CVI
    # ------------------------------------------------------------------
    def calculate_cvi_expert_matrix(
        self,
        expert_ratings_df: pd.DataFrame,
    ) -> Dict:
        ratings = expert_ratings_df.copy()

        missing = [c for c in self.indicators if c not in ratings.index]
        if missing:
            raise ValueError(
                "CVI file must contain all 50 indicators as row labels."
            )

        ratings = ratings.loc[self.indicators]
        ratings = ratings.apply(pd.to_numeric, errors="coerce")

        if ratings.isna().any(axis=None):
            raise ValueError("CVI expert ratings contain missing/non-numeric values.")

        if ((ratings < 1) | (ratings > 4)).any(axis=None):
            raise ValueError("CVI ratings must use the 1-4 scale.")

        relevant_ratings = (ratings >= 3).sum(axis=1)
        total_experts = ratings.shape[1]

        i_cvi = relevant_ratings / total_experts
        s_cvi_ave = float(i_cvi.mean())

        return {
            "Item_CVI_per_Indicator": i_cvi,
            "Overall_S_CVI_Average": s_cvi_ave,
            "Pass_Validation": bool(s_cvi_ave >= 0.80),
        }

    # ------------------------------------------------------------------
    # Full analysis
    # ------------------------------------------------------------------
    def analyze(
        self,
        raw_df: pd.DataFrame,
        num_simulations: int = DEFAULT_SIMULATIONS,
        precision_k: float = DEFAULT_PRECISION_K,
        perturbation_factor: float = DEFAULT_PERTURBATION,
        seed: int = 42,
        pairwise_matrix=None,
        cvi_df=None,
    ) -> Dict:
        self.validate_input(raw_df)

        df_norm = self.normalize_min_max(raw_df)

        linear = self.aggregate_linear(df_norm)
        geometric = self.aggregate_geometric_zero_safe(df_norm)

        results = pd.DataFrame({
            "Linear_Score": linear,
            "Linear_Rank": linear.rank(ascending=False, method="average"),
            "Geometric_Score": geometric,
            "Geometric_Rank": geometric.rank(
                ascending=False, method="average"
            ),
        }).sort_values("Linear_Rank")

        mc_summary, mc_table = self.run_calibrated_dirichlet_monte_carlo(
            df_norm,
            num_simulations=num_simulations,
            precision_k=precision_k,
            seed=seed,
        )

        perturbation = self.weight_perturbation_scenario(
            df_norm,
            factor=perturbation_factor,
        )

        lodo = self.leave_one_dimension_out_analysis(df_norm)

        weights_table = pd.DataFrame({
            "Dimension_Weight": self.dimension_weights,
            "Sub_Indicator_Weight": {
                d: w / 5.0 for d, w in self.dimension_weights.items()
            },
        })

        output = {
            "Input_Raw": raw_df,
            "Normalized": df_norm,
            "Dimension_Weights": weights_table,
            "Scores_Ranks": results,
            "Monte_Carlo": mc_table,
            "Weight_Perturbation": perturbation,
            "LODO": lodo,
            "MC_Avg_Spearman": mc_summary["Avg_Spearman_Rho"],
            "MC_Avg_Kendall": mc_summary["Avg_Kendall_Tau"],
        }

        if pairwise_matrix is not None:
            output["AHP_Consistency"] = pd.DataFrame(
                [self.calculate_ahp_consistency(pairwise_matrix)]
            )

        if cvi_df is not None:
            cvi = self.calculate_cvi_expert_matrix(cvi_df)
            output["CVI_Item"] = cvi["Item_CVI_per_Indicator"].to_frame(
                "I_CVI"
            )
            output["CVI_Summary"] = pd.DataFrame([{
                "S_CVI_Average": cvi["Overall_S_CVI_Average"],
                "Validation_Pass_Threshold_0.80": cvi["Pass_Validation"],
            }])

        return output

    # ------------------------------------------------------------------
    # Template helpers
    # ------------------------------------------------------------------
    def create_template(self, path: Path, languages=None) -> None:
        if languages is None:
            languages = ["Arabic", "English", "French", "Chinese", "Spanish", "German"]

        df = pd.DataFrame(index=languages, columns=self.indicators, dtype=float)
        df.index.name = "Language"
        df.to_csv(path, encoding="utf-8-sig")

    def create_demo_data(self, path: Path, seed: int = 42) -> None:
        languages = [
            "Arabic", "English", "French",
            "Chinese", "Spanish", "German"
        ]
        rng = np.random.default_rng(seed)
        values = rng.uniform(10, 90, size=(len(languages), 50))

        df = pd.DataFrame(
            values,
            index=languages,
            columns=self.indicators,
        )
        df.index.name = "Language"
        df.to_csv(path, encoding="utf-8-sig")


def load_ccpli_csv(path: Path) -> pd.DataFrame:
    """Load a CCPLI CSV with first column as language names."""
    df = pd.read_csv(path, encoding="utf-8-sig")

    if df.shape[1] < 51:
        raise ValueError(
            "The CSV must contain Language + exactly 50 CCPLI indicators."
        )

    first_col = df.columns[0]
    df = df.set_index(first_col)
    df.index = df.index.astype(str).str.strip()

    return df


def export_results_to_excel(results: Dict, path: Path) -> None:
    """Write all available analysis tables to an Excel workbook."""
    with pd.ExcelWriter(path, engine="openpyxl") as writer:
        for sheet_name, obj in results.items():
            if isinstance(obj, pd.Series):
                out = obj.to_frame()
            elif isinstance(obj, pd.DataFrame):
                out = obj.copy()
            else:
                continue

            safe_name = str(sheet_name)[:31]
            out.to_excel(writer, sheet_name=safe_name)

        summary = pd.DataFrame({
            "Metric": [
                "Monte Carlo simulations",
                "Average Spearman rho",
                "Average Kendall tau",
            ],
            "Value": [
                results.get("_MC_SIMULATIONS", ""),
                results.get("MC_Avg_Spearman", ""),
                results.get("MC_Avg_Kendall", ""),
            ],
        })
        summary.to_excel(writer, sheet_name="Summary", index=False)


class CCPLIGUI:
    """Simple Windows GUI for the CCPLI V4 engine."""

    def __init__(self, root: tk.Tk):
        self.root = root
        self.root.title(APP_TITLE)
        self.root.geometry("1050x720")
        self.root.minsize(900, 620)

        self.engine = CCPLIV4OfficialEngine()
        self.data_path: Optional[Path] = None
        self.last_results: Optional[Dict] = None

        self.simulations_var = tk.StringVar(value=str(DEFAULT_SIMULATIONS))
        self.precision_var = tk.StringVar(value=str(DEFAULT_PRECISION_K))
        self.perturbation_var = tk.StringVar(value=str(DEFAULT_PERTURBATION))
        self.status_var = tk.StringVar(
            value="Ready. Create a template or load a CCPLI CSV."
        )

        self._build_ui()

    def _build_ui(self):
        main = ttk.Frame(self.root, padding=12)
        main.pack(fill="both", expand=True)

        title = ttk.Label(
            main,
            text="CCPLI V4 — Official Windows Analysis Engine",
            font=("Segoe UI", 18, "bold"),
        )
        title.pack(anchor="w", pady=(0, 4))

        subtitle = ttk.Label(
            main,
            text=(
                "10 dimensions • 50 indicators • Linear + Geometric • "
                "Monte Carlo • Sensitivity • Validity"
            ),
        )
        subtitle.pack(anchor="w", pady=(0, 12))

        controls = ttk.LabelFrame(main, text="Data & Analysis", padding=10)
        controls.pack(fill="x")

        ttk.Button(
            controls,
            text="1. Create CSV Template",
            command=self.create_template,
        ).grid(row=0, column=0, padx=5, pady=5, sticky="ew")

        ttk.Button(
            controls,
            text="2. Load CSV Data",
            command=self.load_data,
        ).grid(row=0, column=1, padx=5, pady=5, sticky="ew")

        ttk.Button(
            controls,
            text="Create Demo CSV",
            command=self.create_demo,
        ).grid(row=0, column=2, padx=5, pady=5, sticky="ew")

        ttk.Button(
            controls,
            text="3. Run CCPLI V4",
            command=self.run_analysis,
        ).grid(row=0, column=3, padx=5, pady=5, sticky="ew")

        ttk.Button(
            controls,
            text="4. Export Excel",
            command=self.export_excel,
        ).grid(row=0, column=4, padx=5, pady=5, sticky="ew")

        for col in range(5):
            controls.columnconfigure(col, weight=1)

        params = ttk.LabelFrame(main, text="Parameters", padding=10)
        params.pack(fill="x", pady=10)

        ttk.Label(params, text="Monte Carlo runs:").grid(
            row=0, column=0, sticky="w", padx=5
        )
        ttk.Entry(params, textvariable=self.simulations_var, width=14).grid(
            row=0, column=1, padx=5
        )

        ttk.Label(params, text="Dirichlet K:").grid(
            row=0, column=2, sticky="w", padx=5
        )
        ttk.Entry(params, textvariable=self.precision_var, width=14).grid(
            row=0, column=3, padx=5
        )

        ttk.Label(params, text="Perturbation factor:").grid(
            row=0, column=4, sticky="w", padx=5
        )
        ttk.Entry(
            params, textvariable=self.perturbation_var, width=14
        ).grid(row=0, column=5, padx=5)

        ttk.Label(
            params,
            text="Default: 10,000 runs | K=100 | +20%",
        ).grid(row=0, column=6, padx=10, sticky="w")

        status_frame = ttk.LabelFrame(main, text="Status", padding=10)
        status_frame.pack(fill="x", pady=(0, 10))

        ttk.Label(
            status_frame,
            textvariable=self.status_var,
            wraplength=980,
        ).pack(anchor="w")

        output_frame = ttk.LabelFrame(main, text="Results Preview", padding=8)
        output_frame.pack(fill="both", expand=True)

        columns = (
            "Language",
            "Linear Score",
            "Linear Rank",
            "Geometric Score",
            "Geometric Rank",
        )

        self.tree = ttk.Treeview(
            output_frame,
            columns=columns,
            show="headings",
        )

        for col in columns:
            self.tree.heading(col, text=col)
            self.tree.column(col, width=170, anchor="center")

        scrollbar = ttk.Scrollbar(
            output_frame,
            orient="vertical",
            command=self.tree.yview,
        )
        self.tree.configure(yscrollcommand=scrollbar.set)

        self.tree.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

    def create_template(self):
        path = filedialog.asksaveasfilename(
            title="Save CCPLI V4 CSV Template",
            defaultextension=".csv",
            filetypes=[("CSV files", "*.csv")],
            initialfile="ccpli_v4_template.csv",
        )
        if not path:
            return

        try:
            self.engine.create_template(Path(path))
            self.status_var.set(f"Template created: {path}")
            messagebox.showinfo(
                "CCPLI V4",
                "CSV template created successfully.\n\n"
                "Fill the 50 indicators for each language, save the CSV, "
                "then use 'Load CSV Data'.",
            )
        except Exception as exc:
            self.show_error(exc)

    def create_demo(self):
        path = filedialog.asksaveasfilename(
            title="Save simulated CCPLI V4 test data",
            defaultextension=".csv",
            filetypes=[("CSV files", "*.csv")],
            initialfile="ccpli_v4_demo_data.csv",
        )
        if not path:
            return

        try:
            self.engine.create_demo_data(Path(path))
            self.status_var.set(f"Demo data created: {path}")
            messagebox.showinfo(
                "Demo data",
                "Simulated test data created.\n\n"
                "This data are NOT research results and must not be "
                "reported as empirical findings.",
            )
        except Exception as exc:
            self.show_error(exc)

    def load_data(self):
        path = filedialog.askopenfilename(
            title="Open CCPLI V4 CSV",
            filetypes=[("CSV files", "*.csv"), ("All files", "*.*")],
        )
        if not path:
            return

        try:
            df = load_ccpli_csv(Path(path))
            self.engine.validate_input(df)
            self.data_path = Path(path)
            self.status_var.set(
                f"Loaded {len(df)} languages and 50 indicators: {path}"
            )
            messagebox.showinfo(
                "Data loaded",
                f"Loaded successfully.\n\nLanguages: {len(df)}\n"
                f"Indicators: {len(self.engine.indicators)}",
            )
        except Exception as exc:
            self.show_error(exc)

    def run_analysis(self):
        if self.data_path is None:
            messagebox.showwarning(
                "No data",
                "Load a CCPLI CSV first, or create/load the Demo CSV.",
            )
            return

        try:
            simulations = int(self.simulations_var.get())
            precision_k = float(self.precision_var.get())
            perturbation = float(self.perturbation_var.get())

            if simulations < 100:
                raise ValueError("Monte Carlo runs must be at least 100.")

            self.status_var.set(
                f"Running CCPLI V4... {simulations:,} Monte Carlo simulations."
            )
            self.root.update_idletasks()

            raw_df = load_ccpli_csv(self.data_path)

            results = self.engine.analyze(
                raw_df,
                num_simulations=simulations,
                precision_k=precision_k,
                perturbation_factor=perturbation,
            )
            results["_MC_SIMULATIONS"] = simulations

            self.last_results = results
            self.populate_results(results["Scores_Ranks"])

            rho = results["MC_Avg_Spearman"]
            tau = results["MC_Avg_Kendall"]

            self.status_var.set(
                f"Analysis complete. Average Spearman = {rho:.4f}; "
                f"Average Kendall = {tau:.4f}."
            )

            messagebox.showinfo(
                "CCPLI V4",
                "Analysis completed successfully.\n\n"
                f"Average Spearman rho: {rho:.4f}\n"
                f"Average Kendall tau: {tau:.4f}",
            )

        except Exception as exc:
            self.status_var.set("Analysis failed. See error message.")
            self.show_error(exc)

    def populate_results(self, table: pd.DataFrame):
        for item in self.tree.get_children():
            self.tree.delete(item)

        for language, row in table.iterrows():
            self.tree.insert(
                "",
                "end",
                values=(
                    language,
                    f"{row['Linear_Score']:.4f}",
                    f"{row['Linear_Rank']:.0f}",
                    f"{row['Geometric_Score']:.4f}",
                    f"{row['Geometric_Rank']:.0f}",
                ),
            )

    def export_excel(self):
        if self.last_results is None:
            messagebox.showwarning(
                "No results",
                "Run the CCPLI V4 analysis before exporting.",
            )
            return

        path = filedialog.asksaveasfilename(
            title="Export CCPLI V4 Excel Report",
            defaultextension=".xlsx",
            filetypes=[("Excel workbook", "*.xlsx")],
            initialfile="CCPLI_V4_Analysis_Report.xlsx",
        )
        if not path:
            return

        try:
            export_results_to_excel(
                self.last_results,
                Path(path),
            )
            self.status_var.set(f"Excel report exported: {path}")
            messagebox.showinfo(
                "Export complete",
                f"Excel report saved successfully:\n\n{path}",
            )
        except Exception as exc:
            self.show_error(exc)

    @staticmethod
    def show_error(exc: Exception):
        details = "".join(
            traceback.format_exception(type(exc), exc, exc.__traceback__)
        )
        messagebox.showerror(
            "CCPLI V4 Error",
            f"{exc}\n\nTechnical details:\n{details}",
        )


def main():
    root = tk.Tk()
    app = CCPLIGUI(root)

    def on_close():
        root.destroy()

    root.protocol("WM_DELETE_WINDOW", on_close)
    root.mainloop()


